class GoodMorning extends Thread {
	// write your code here
	int n;
    GoodMorning(int n){
		this.n=n;
	}
    public synchronized void run() {
        try {
			for(int i=0;i&lt;n;i++){
				Thread.sleep(200);
				System.out.println("Good morning");
			}} 
        catch (Exception e) {
            System.out.println(e);
        }
    }
}

class Hello extends Thread {
    // write your code here
