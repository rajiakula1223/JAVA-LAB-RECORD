import java.util.*;
public class ArithmeticMain {
    public static void main(String[] args) {
    	Scanner sc = new Scanner(System.in);
    	System.out.print("First number: ");
    	int a = sc.nextInt();
    	System.out.print("Second number: ");
    	int b = sc.nextInt();
        System.out.println("Sum: " + Arithmetic.add(a, b));
        System.out.println("Difference: " + Arithmetic.subtract(a, b));
        System.out.println("Product: " + Arithmetic.multiply(a, b));
        if (b != 0) {
            System.out.println("Divison: " + Arithmetic.divide(a, b));
        } else {
            System.out.println("Cannot divide by zero");
        }
    }
}</pre><br data-ref="24110cff-a792-4c64-b280-06b616ec664c"></div></div><div class="row" data-ref="e83eaefc-2d9d-401d-bca6-f92da6718a14"><div class="col-12" data-ref="96848692-20af-42cb-a0d3-fe3d3be3e28d"><h5 class="execResultsHeading text-center" data-ref="4d04427f-1012-4af1-84bd-ed092438c3b2">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="6c1da305-236f-49c8-aaa6-2fe3cc29f53a" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="21f2a191-52f2-4d77-80af-28b4893061bd"><div class="row execution-results-border" data-ref="996e4571-49a9-424c-ae67-6ebab74e4fb9"><div class="col-12 p-2 text-center font-weight-bold" data-ref="0afce2d6-bfb8-428e-9f97-6723f1ad5b7e">Test Case - 1</div></div><div class="row execution-results-border" data-ref="55f5c217-9aac-435f-a169-36385c7734e5"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="80c02aff-3242-48c8-bc06-71939c49fa9e">User Output</div></div><div class="row execution-results-border" data-ref="6df3c92a-8be6-42a4-9c45-0849ca22819c"><div class="col-12" data-ref="99a6cbb9-fb26-4cda-9a54-41a3c26e40ef"><pre class="outputPre" data-ref="8bee0f6b-ea60-4eff-9110-bf01a4c8190e">First number: </pre></div></div><div class="row execution-results-border" data-ref="2fa37386-6ec1-4529-a30d-3c2a79a6ac26"><div class="col-6" data-ref="c7d041d0-dd6c-44be-b9c0-c6d803a1d600"><span class="cmd" title="User Input" data-ref="ae7d9ac3-f40b-42e3-a3a8-521f2e04a884">12</span></div></div><div class="row execution-results-border" data-ref="121a1988-97c5-44a8-9e1b-4a9576568456"><div class="col-12" data-ref="84435ce3-e28f-4d88-966e-f8867d5f433c"><pre class="outputPre" data-ref="da15a151-87df-4f52-91d4-e9f185580eab">Second number: </pre></div></div><div class="row execution-results-border" data-ref="97c5817d-0c20-4673-b451-ab445e088bbe"><div class="col-6" data-ref="1e07b513-4a88-466d-9f03-994c108bb025"><span class="cmd" title="User Input" data-ref="4