public class MultithreadDemo {
    public static void main(String args[]) {
        Scanner scanner = new Scanner(System.in);

        // Take inputs
        int gmCount = scanner.nextInt(); // repetitions for Good Morning
        int helloCount = scanner.nextInt(); // repetitions for Hello
        int welcomeCount = scanner.nextInt(); // repetitions for Welcome
        // write your code here
        GoodMorning gm=new GoodMorning(gmCount);
		Hello h=new Hello(helloCount);
		Welcome w=new Welcome(welcomeCount);
        gm.start();
		h.start();
		w.start();
        
        
        scanner.close();
    }
}</pre><br data-ref="b99aa25c-ce04-452a-b03b-74d3409a19aa"></div></div><div class="row" data-ref="64dde0d2-a32a-41f4-adcc-7b4e1a34b952"><div class="col-12" data-ref="695d856c-a6a2-4ac4-9f3c-6d8e0c8915db"><h5 class="execResultsHeading text-center" data-ref="88ca4181-2077-45a0-abb8-e5b73933a10a">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="072c2362-8ebf-4a6b-a96e-8d23c0853ce7" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="028207a3-bef7-4049-8278-c1f71be81935" data-split-to="028207a3-bef7-4049-8278-c1f71be81935" data-split-original="true" data-last-split-element="true" data-align-last-split-element="auto"><div class="row execution-results-border" data-ref="cfae6dab-1594-46c1-b09d-6f4ff9a6a974"><div class="col-12 p-2 text-center font-weight-bold" data-ref="8ed67797-d783-47c8-a96f-72b6bbaddb24">Test Case - 1</div></div><div class="row execution-results-border" data-ref="a62ab5b2-5a88-4f85-a9e1-d7791f553878"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="f9676784-3c97-4ff6-9ffb-beed18c88420">User Output</div></div><div class="row execution-results-border" data-ref="1488c359-0965-4fd7-b566-3d074d35ea20"><div class="col-6" data-ref="f3e857a0-fc8d-452f-be48-e71bc723a5bd"><span class="cmd" title="User Input" data-ref="e7bb0bfe-900a-4998-886c-8bfb91431be8">2</span></div></div><div class="row execution-results-border" data-ref="83a1ab11-22eb-49de-803e-b467091fd643"><div class="col-6" data-ref="154d8666-2d58-44f7-920c-ef217ed83aa1"><span class="cmd" title="User Input" data-ref="0bad4ac1-0725-468d-a6c3-f279ff4a89c1">3</span></div></div></div></div></div></div></div></div></div>
