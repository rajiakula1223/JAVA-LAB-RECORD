				<div class="pagedjs_page_content" style="column-width: 624px; column-gap: calc(var(--pagedjs-margin-right) + var(--pagedjs-margin-left));"><div><div class="container-xl" data-ref="7cb5fa85-9758-4dfe-86f0-f120aeeba20c" data-split-from="7cb5fa85-9758-4dfe-86f0-f120aeeba20c" data-split-to="7cb5fa85-9758-4dfe-86f0-f120aeeba20c"><div class="page" data-ref="938e076f-4f34-4357-b5da-5bd23e258d8b" data-split-from="938e076f-4f34-4357-b5da-5bd23e258d8b" data-split-to="938e076f-4f34-4357-b5da-5bd23e258d8b"><div data-ref="dc59c255-4c05-4f74-867c-caf558f627f1" data-id="lab-print" data-split-from="dc59c255-4c05-4f74-867c-caf558f627f1" data-split-to="dc59c255-4c05-4f74-867c-caf558f627f1"><div class="ct-print-new-page-after-always" data-ref="d48dcf9c-9ffe-4467-80f8-4178f11b6762" data-break-after="always" data-split-from="d48dcf9c-9ffe-4467-80f8-4178f11b6762" data-split-to="d48dcf9c-9ffe-4467-80f8-4178f11b6762" data-last-split-element="true" data-align-last-split-element="auto"><div class="mb-3" data-ref="2a5ca6c6-ec9d-4baf-a723-25bd4221851f" data-split-from="2a5ca6c6-ec9d-4baf-a723-25bd4221851f"><div class="user-solution" style="page-break-inside: auto" data-ref="5f707bfb-f52d-4aa1-afb5-b498cb9febfc" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="ae7c7b43-24df-4f8f-8b60-d916b74337c9" data-undisplayed="undisplayed">q17128/CTJ17128.java</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="b9fe63fa-2b64-4cda-9edc-ada22d01def3" data-undisplayed="undisplayed">package q17128;
import java.util.Scanner;
public class CTJ17128{
	public static void main(String args[])
	{
		Scanner s=new Scanner(System.in);
		int n=s.nextInt();
		int []a=new int[n];
		for(int i=0;i&lt;n;i++)
			{
				a[i]=s.nextInt();
			}
		int key=s.nextInt();
		int l=0;
		int h=n-1;
		int result=-1;
		while(l&lt;=h)
			{
				int mid=(l+h)/2;
				if(a[mid]==key)
				{
					result=mid;
					h=mid-1;
				}
				else if(a[mid]&lt;key)
				{
					l=mid+1;
				}
				else{
					h=mid-1;
				}
			}
				if(result!=-1)
				{
					System.out.println(result);
				}
		else{
			System.out.println("Not found");
		}
		s.close();
	}

}</pre><br data-ref="2fda1427-9f53-4a81-99fc-75456ee421c1"></div></div></div></div></div></div></div></div>
