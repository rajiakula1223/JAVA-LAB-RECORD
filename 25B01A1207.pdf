        System.out.print("Enter the count for Second Thread: ");
        int count2 = scanner.nextInt();

        FirstThread firstThread = new FirstThread(count1);
        SecondThread secondThread = new SecondThread(count2);

        firstThread.start();
        secondThread.start();
        System.out.println("FirstThread is alive: " +firstThread.isAlive());
        System.out.println("SecondThread is alive: " +secondThread.isAlive());

        try {
            // Wait for threads to finish
            System.out.println("Waiting for FirstThread to finish.");
			firstThread.join();
            System.out.println("FirstThread has finished.");
			System.out.println("Waiting for SecondThread to finish.");
			secondThread.join();
            System.out.println("SecondThread has finished.");
        } catch (InterruptedException e) {
            System.out.println("Main thread interrupted: " + e);
        }

        // Check again if threads are alive after join
        System.out.println("FirstThread is alive after join: " +firstThread.isAlive());
        System.out.println("SecondThread is alive after join: " +secondThread.isAlive());

        System.out.println("Main thread has finished.");
    }
