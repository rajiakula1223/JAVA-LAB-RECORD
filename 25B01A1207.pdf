import java.util.*;
public class CubeRootCalculator {
    // write your code here 
	public static void main(String args[]){
    Scanner s=new Scanner(System.in);
		try {
	double num=Double.parseDouble(s.nextLine());
	if(num&lt;0){
		throw new IllegalArgumentException(" Cannot calculate cube root of a negative number");
	}
	double res=Math.cbrt(num);
	System.out.println(res);
        } catch (InputMismatchException | IllegalArgumentException e) {
	if(e instanceof NumberFormatException){
		System.out.println("An error occurred: Invalid input format");
	}
	else{
		System.out.println("An error occurred:" + e.getMessage());}
		}
    	}

    
}
