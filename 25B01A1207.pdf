				<div class="pagedjs_page_content" style="column-width: 624px; column-gap: calc(var(--pagedjs-margin-right) + var(--pagedjs-margin-left));"><div><div class="container-xl" data-ref="7cb5fa85-9758-4dfe-86f0-f120aeeba20c" data-split-from="7cb5fa85-9758-4dfe-86f0-f120aeeba20c" data-split-to="7cb5fa85-9758-4dfe-86f0-f120aeeba20c"><div class="page" data-ref="938e076f-4f34-4357-b5da-5bd23e258d8b" data-split-from="938e076f-4f34-4357-b5da-5bd23e258d8b" data-split-to="938e076f-4f34-4357-b5da-5bd23e258d8b"><div data-ref="dc59c255-4c05-4f74-867c-caf558f627f1" data-id="lab-print" data-split-from="dc59c255-4c05-4f74-867c-caf558f627f1" data-split-to="dc59c255-4c05-4f74-867c-caf558f627f1"><div class="ct-print-new-page-after-always" data-ref="bea2a7f5-d3de-463a-afc0-ecacf3fbd380" data-break-after="always" data-split-from="bea2a7f5-d3de-463a-afc0-ecacf3fbd380" data-split-to="bea2a7f5-d3de-463a-afc0-ecacf3fbd380" data-last-split-element="true" data-align-last-split-element="auto"><div class="mb-3" data-ref="a7b64804-c850-47a9-b3bb-e6dcc64aae7c" data-split-from="a7b64804-c850-47a9-b3bb-e6dcc64aae7c"><div class="user-solution" style="page-break-inside: auto" data-ref="3e16daf6-f725-403d-a6e6-031e4f54ff8f" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="911671bf-c375-4181-be5c-a633caf038b3" data-undisplayed="undisplayed">DaemonThread.java</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="54c3d11e-960f-4a78-a435-d65811349fbd" data-undisplayed="undisplayed">import java.util.Scanner;

class WorkerThread extends Thread {
	WorkerThread(String name){
			super(name);
}
public void run(){
	try{
	System.out.println(getName() + " started");
		if(isDaemon()){
			Thread.sleep(100);
		}else{
	Thread.sleep(3000);}
	System.out.println(getName() + " finished");
	}catch(InterruptedException e){
			System.out.println(e);
		}
		}
}
public class DaemonThread {
	public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter the number of user threads: ");
        int numUserThreads = scanner.nextInt();

        System.out.print("Enter the number of daemon threads: ");
        int numDaemonThreads = scanner.nextInt();
		for(int i=1;i&lt;=numUserThreads;i++){
			WorkerThread t=new WorkerThread("Thread " + i);
			t.setDaemon(false);
			t.start();
		}
		for(int i=1;i&lt;=numDaemonThreads;i++){
			WorkerThread t=new WorkerThread("Thread "+i);
			t.setDaemon(true);
			t.start();
		}
        
        
        
        System.out.println("Main thread exiting");
    }
}</pre><br data-ref="5862b549-3c2f-485a-bc31-aee54151143a"></div></div></div></div></div></div></div></div>
