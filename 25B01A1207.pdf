				<div class="pagedjs_page_content" style="column-width: 624px; column-gap: calc(var(--pagedjs-margin-right) + var(--pagedjs-margin-left));"><div><div class="container-xl" data-ref="7cb5fa85-9758-4dfe-86f0-f120aeeba20c" data-split-from="7cb5fa85-9758-4dfe-86f0-f120aeeba20c" data-split-to="7cb5fa85-9758-4dfe-86f0-f120aeeba20c"><div class="page" data-ref="938e076f-4f34-4357-b5da-5bd23e258d8b" data-split-from="938e076f-4f34-4357-b5da-5bd23e258d8b" data-split-to="938e076f-4f34-4357-b5da-5bd23e258d8b"><div data-ref="dc59c255-4c05-4f74-867c-caf558f627f1" data-id="lab-print" data-split-from="dc59c255-4c05-4f74-867c-caf558f627f1" data-split-to="dc59c255-4c05-4f74-867c-caf558f627f1"><div class="ct-print-new-page-after-always" data-ref="cb7f1754-261f-467a-8902-29fee605202c" data-break-after="always" data-split-from="cb7f1754-261f-467a-8902-29fee605202c" data-split-to="cb7f1754-261f-467a-8902-29fee605202c"><div class="mb-3" data-ref="cdbb5dd7-6ca9-4cac-b927-373833ffe37e" data-split-from="cdbb5dd7-6ca9-4cac-b927-373833ffe37e"><div class="user-solution" style="page-break-inside: auto" data-ref="23fa5221-6c4e-4689-802b-d5b78a50db0d" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="0fb0f468-57a4-4930-9dd0-02bc31830ff3" data-undisplayed="undisplayed">CheckWeight.java</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="ed27a9db-4484-48f6-b273-deb153ab43f6" data-undisplayed="undisplayed">import java.util.*;
import java.lang.*;
class InvalidWeight extends Exception {
	public InvalidWeight(String message){
		super(message);
	}
}
class CheckWeight {
	public void validWeight(int weight)throws InvalidWeight{
		if(weight&gt;100){
			throw new InvalidWeight(weight +" is invalid weight\n");
		}
		else{
			System.out.println(weight +" is the valid weight");
		}
		}
	public static void main(String args[]) {
		CheckWeight cw = new CheckWeight();
		Scanner sc = new Scanner(System.in);
		int weight;
		System.out.print("Enter weight: ");
		weight = sc.nextInt();
		try {
			cw.validWeight(weight);
		} catch(InvalidWeight iw) {
			System.out.print("Exception caught: " + iw.getMessage());
		}
	}
	
}

