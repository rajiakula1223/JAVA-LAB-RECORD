		this.n=n;
	}
	public void run(){
		for(int i=1;i&lt;=n;i++){
			buffer.consume();
		}
	}}
public class ProducerConsumerDemo {
	public static void main(String args[])throws InterruptedException{
		Scanner sc=new Scanner(System.in);
		System.out.println("Enter the number of items to produce: ");
		int n=sc.nextInt();
		Buffer buffer=new Buffer();
		Producer producer=new Producer(buffer,n);
		Consumer consumer=new Consumer(buffer,n);
		producer.start();
		consumer.start();
		producer.join();
		consumer.join();
		sc.close();
	}
}</pre><br data-ref="a6a97803-2dcb-4e29-8a43-ac9eb389eb1d"></div></div><div class="row" data-ref="ef8a5b27-211b-4d95-bdf7-07c41c757d54"><div class="col-12" data-ref="d1fab177-9780-46ee-a058-821783c25ea8"><h5 class="execResultsHeading text-center" data-ref="479eec9c-b117-48e0-90b5-741d8b915e4d">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="79b053f6-4bc1-4848-b082-426318e1c700" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="86d44764-fbbc-4f6d-803b-889efa797b19"><div class="row execution-results-border" data-ref="c18c4040-3ed2-463d-a867-7fc07760906e"><div class="col-12 p-2 text-center font-weight-bold" data-ref="62f22239-a8b4-4c27-9700-047ce0c58eb2">Test Case - 1</div></div><div class="row execution-results-border" data-ref="78264884-f2bf-475a-8bf5-90be0332d216"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="de1ebee2-9d2a-47de-a22e-54b694f742ab">User Output</div></div><div class="row execution-results-border" data-ref="8153f506-eb53-41f8-9ced-e4351ed452c4"><div class="col-12" data-ref="42187f97-9ea7-4cac-84db-0827bafec0d0"><pre class="outputPre" data-ref="e4d75ae2-f56c-4609-a456-9a427b6dc9dc">Enter the number of items to produce: </pre></div></div><div class="row execution-results-border" data-ref="e6a69cb7-844c-4222-91d5-1114fcc45386"><div class="col-6" data-ref="22a44690-4925-4e12-8b1a-80dcea4927b7"><span class="cmd" title="User Input" data-ref="d8d79c24-1384-41e4-ba90-1a566fd0e483">3</span></div></div><div class="row execution-results-border" data-ref="9d0d3eb6-e9a0-4cf8-b5ed-025ab33d3270"><div class="col-12" data-ref="b86d5564-696a-4f58-9f82-6aaf33bb3947"><pre class="outputPre" data-ref="9edf0b04-ba4f-4a8c-a209-44441eea7ad5">Produced: 1</pre></div></div><div class="row execution-results-border" data-ref="cff29c2a-80e6-4139-990c-275adad17b84"><div class="col-12" data-ref="c8c5193b-58da-44be-b3ce-72ed1a754021"><pre class="outputPre" data-